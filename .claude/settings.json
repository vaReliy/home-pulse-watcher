{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true,
    "superpowers@superpowers-marketplace": true
  },
  "enabledMcpjsonServers": ["context7", "github"],
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./firmware/esp32c3/include/secrets.h)",
      "Read(./firmware/esp32c6/include/secrets.h)"
    ]
  },
  "model": "opusplan",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint apps/ libs/ --fix --quiet || true",
            "statusMessage": "Fixing ESLint issues..."
          },
          {
            "type": "command",
            "command": "npx prettier --write . --log-level warn",
            "statusMessage": "Formatting code with Prettier..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  }
}
