{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true,
    "superpowers@superpowers-marketplace": true
  },
  "enabledMcpjsonServers": [
    "context7",
    "github"
  ],
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./firmware/esp32c3/include/secret.h)",
      "Read(./firmware/esp32c6/include/secret.h)"
    ]
  },
  "model": "opusplan",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "docker compose exec app npx eslint . --fix --quiet",
            "statusMessage": "Fixing ESLint issues..."
          },
          {
            "type": "command",
            "command": "docker compose exec app npx prettier --write . --log-level warn",
            "statusMessage": "Formatting code with Prettier..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  }
}
