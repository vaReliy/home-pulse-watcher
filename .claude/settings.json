{
  "enabledMcpjsonServers": [
    "context7",
    "figma",
    "github"
  ],
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/knowledge-capture-nudge.sh",
            "statusMessage": "Checking knowledge-capture obligations..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint apps/ libs/ --fix --quiet || true",
            "statusMessage": "Fixing ESLint issues..."
          },
          {
            "type": "command",
            "command": "npx prettier --write . --log-level warn",
            "statusMessage": "Formatting code with Prettier..."
          }
        ]
      }
    ]
  },
  "model": "opusplan",
  "permissions": {
    "deny": [
      "Edit(./.cts/**)",
      "Edit(./rules/cts/**)",
      "Read(./.env)",
      "Read(./firmware/esp32c3/include/secrets.h)",
      "Read(./firmware/esp32c6/include/secrets.h)",
      "Write(./.cts/**)",
      "Write(./rules/cts/**)"
    ]
  }
}
