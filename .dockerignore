# Dependencies (installed inside container)
node_modules

# Build output (built inside container)
dist
out-tsc
apps/*/dist
apps/*/out-tsc
libs/*/dist
libs/*/out-tsc

# Git
.git
.gitignore

# IDE
.vscode
.idea
.history

# Nx cache
.nx

# Claude
.claude

# CI/CD
.github

# Tests
**/*.spec.ts
**/*.test.ts
**/jest.config.*
**/.spec.swcrc
apps/api-e2e

# Firmware build artifacts (keep source for firmware Docker builds)
# Note: .dockerignore is shared across both root Dockerfile (API) and firmware/Dockerfile.
# Firmware source (*.cpp, *.h, platformio.ini) intentionally flows into context for
# firmware builds; it incidentally enters API image context (small, low-impact).
# Use recursive patterns to match nested directories (e.g., firmware/esp32c6/.pio)
firmware/**/.pio/
firmware/**/.history/
firmware/**/.vscode/
firmware/**/.claude/
# Explicit secret file exclusion — must never enter Docker build context
firmware/**/include/secrets.h

# Documentation (not needed in image)
docs

# Environment files
.env
.env.local
.env.*.local

# Misc
*.md
LICENSE
.editorconfig
.prettierrc
.prettierignore
coverage
test-output
generated
