{
  "name": "@home-pulse-watcher/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "scope:api",
      "type:app"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate deploy"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build",
          "migrate"
        ],
        "options": {
          "buildTarget": "@home-pulse-watcher/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@home-pulse-watcher/api:build:development"
          },
          "production": {
            "buildTarget": "@home-pulse-watcher/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker:build": {
        "dependsOn": [
          "build"
        ]
      },
      "cli": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node dist/cli.js",
          "cwd": "apps/api"
        }
      }
    }
  },
  "dependencies": {
    "@google-cloud/storage": "7.19.0",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "dotenv": "16.4.5",
    "nestjs-pino": "4.6.0",
    "pg": "8.17.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.3.0",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.2",
    "thread-stream": "4.0.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.12"
  }
}
