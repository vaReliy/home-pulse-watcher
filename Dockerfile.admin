# Admin CLI container with gcloud SDK
# Bundles nest-commander CLI (cli.js) with Google Cloud Storage access
# Build: docker compose --profile admin build admin
# Run: docker compose --profile admin run --rm admin user:list
#
# Prerequisites: npx nx build api  (populates apps/api/dist/)
# Auth: gcloud auth application-default login  (on host, one-time)
#
# NOTE: pin google/cloud-sdk to a specific version before sharing this image.
# Check latest at: https://hub.docker.com/r/google/cloud-sdk/tags?name=alpine

FROM google/cloud-sdk:alpine AS gcloud

FROM node:22-alpine

COPY --from=gcloud /google-cloud-sdk /opt/google-cloud-sdk
ENV PATH="/opt/google-cloud-sdk/bin:${PATH}"

WORKDIR /app

# Copy pre-built bundled application (requires: npx nx build api)
COPY apps/api/dist/ /app/
COPY apps/api/src/assets/package.json /app/package.json

# Copy Prisma schema and config (required for prisma generate)
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts

# Install production dependencies (Prisma + pg) + Prisma CLI
# assets/package.json has no lockfile → npm install, not npm ci
RUN npm install --omit=dev && npm install --no-save prisma@7 dotenv

# Generate Prisma client in production node_modules
RUN npx prisma generate

# Run as non-root (node user is built into official node images)
RUN chown -R node:node /app
USER node

ENTRYPOINT ["node", "/app/cli.js"]
