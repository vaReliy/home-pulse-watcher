# --- DATABASE ---
# Development: postgresql://admin:password@localhost:5432/home_pulse_watcher?schema=public
# Production (Neon.tech): postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- NESTJS APP SETTINGS ---
# Development: 3000, Production (Cloud Run): 8080
PORT=3000
NODE_ENV=development

# --- TELEGRAM INTEGRATION ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# For production: set to 'true' and provide webhook domain
TELEGRAM_USE_WEBHOOK=false
# Cloud Run URL, e.g., https://home-pulse-watcher-xxxxx-ey.a.run.app
TELEGRAM_WEBHOOK_DOMAIN=
# Shared secret Telegram sends as X-Telegram-Bot-Api-Secret-Token header (webhook auth)
# Production only — generate with: openssl rand -hex 32  (stored in GCP Secret Manager)
# TELEGRAM_WEBHOOK_SECRET=

# --- SECURITY & HMAC ---
# Device secret encryption key (64 hex characters = 32 bytes)
# Generate with: openssl rand -hex 32
DEVICE_SECRET_ENCRYPTION_KEY=

# --- GOOGLE CLOUD STORAGE (OTA firmware hosting) ---
# optional — required for OTA firmware uploads; omit to disable OTA (server starts without it)
# GCS_BUCKET_NAME=
# Service account JSON key with Storage Object Admin on the bucket.
# Paste full JSON string (single line) — or use Application Default Credentials
# locally by leaving this empty and running: gcloud auth application-default login
GCP_SERVICE_ACCOUNT_KEY=

# --- ADMIN FIRMWARE UPLOAD ---
# Bearer token guarding GET/POST /api/admin/firmware (single admin, no session/JWT).
# optional — omit to disable authenticated upload/list actions (they 500);
# the static GET /api/admin/firmware page itself still renders either way.
# Generate with: openssl rand -hex 32
# ADMIN_UPLOAD_TOKEN=

# --- GOOGLE CLOUD (deployment) ---
# GCP_PROJECT_ID=
# GCP_REGION=europe-west3
# CLOUD_RUN_SERVICE=home-pulse-watcher
#
# Production secrets are stored in GCP Secret Manager (not here):
#   database-url                  -> DATABASE_URL
#   telegram-bot-token            -> TELEGRAM_BOT_TOKEN
#   telegram-admin-chat-id        -> TELEGRAM_ADMIN_CHAT_ID
#   device-secret-encryption-key  -> DEVICE_SECRET_ENCRYPTION_KEY
#   telegram-webhook-secret       -> TELEGRAM_WEBHOOK_SECRET
#   gcs-bucket-name               -> GCS_BUCKET_NAME
#   gcp-service-account-key       -> GCP_SERVICE_ACCOUNT_KEY
#   admin-upload-token            -> ADMIN_UPLOAD_TOKEN
