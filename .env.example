# --- DATABASE ---
# Development: postgresql://admin:password@localhost:5432/home_pulse_watcher?schema=public
# Production (Neon.tech): postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- NESTJS APP SETTINGS ---
# Development: 3000, Production (Cloud Run): 8080
PORT=3000
NODE_ENV=development

# --- TELEGRAM INTEGRATION ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# For production: set to 'true' and provide webhook domain
TELEGRAM_USE_WEBHOOK=false
# Cloud Run URL, e.g., https://home-pulse-watcher-xxxxx-ey.a.run.app
TELEGRAM_WEBHOOK_DOMAIN=

# --- SECURITY & HMAC ---
# Device secret encryption key (64 hex characters = 32 bytes)
# Generate with: openssl rand -hex 32
DEVICE_SECRET_ENCRYPTION_KEY=

# --- GOOGLE CLOUD ---
# GCP_PROJECT_ID=
# GCP_REGION=europe-west3
# CLOUD_RUN_SERVICE=home-pulse-watcher
#
# Production secrets are stored in GCP Secret Manager (not here):
#   database-url             -> DATABASE_URL
#   telegram-bot-token       -> TELEGRAM_BOT_TOKEN
#   telegram-admin-chat-id   -> TELEGRAM_ADMIN_CHAT_ID
#   device-secret-encryption-key -> DEVICE_SECRET_ENCRYPTION_KEY
